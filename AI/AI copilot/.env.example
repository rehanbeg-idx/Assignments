# Copy this file to .env and supply your local values.
# Do not commit real secrets.

APP_NAME="AI Customer Support Copilot"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Local PostgreSQL (no Docker).
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# If your password has special characters (@ # : / etc.), URL-encode them.
DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/support_copilot"

# Gemini — used in later phases
GEMINI_API_KEY="Place your key here"
GEMINI_MODEL="Place your Gemini model here"

# Voyage AI embeddings — used in later phases
VOYAGE_API_KEY="Place your key here"
VOYAGE_EMBEDDING_MODEL="Place your embedding model here"

LOG_LEVEL="INFO"

# Document ingestion (Phase 2)
# CHUNK_SIZE and CHUNK_OVERLAP are measured in characters (not tokens).
MAX_DOCUMENT_SIZE_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
